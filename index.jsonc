{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "gg_create_repo",

  // 1-2 sentence summary about this repo.
  "summary": "Creates new Dart and TypeScript repositories with DNA, GitHub setup and a pushed main that passes the gg checks; runs standalone or as gg do create repo.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "collecting and validating the spec of a new repo: name, language, org, DNA",
    "scaffolding Dart and TypeScript repos and applying their DNA with helix",
    "creating the GitHub repo, setting origin in the git protocol gh uses and pushing main, resumable",
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {
      "gg_interact": "prompts for the missing spec values",
      "helix": "applies the DNA layers to the new repo",
      "gg_one_commit": "CanCommit and DoCommit for the first commit",
      "gg_one_core": "buildMustRunScript for the TypeScript scaffold",
      "gg_args": "DirCommand base of the command",
      "gg_process": "process runner for gh, git, dart, pnpm",
      "gg_status_printer": "progress output",
      "gg_console_colors": "colored output",
      "gg_log": "GgLog",
    },

    // "<repo-b>": "why / API"
    "usedBy": {
      "gg_multi_workspace": "RepoCreator behind gg do create repo in a workspace",
      "gg": "GgDna, the helix bridge",
    },
  },
}
